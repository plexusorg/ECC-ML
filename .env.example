# Copy to .env (gitignored) and fill in what you use. The pipeline reads it; nothing logs the values.

# W&B API key (wandb.ai/authorize). `uv run bundle` uploads each classifier bundle with it, and `uv run promote`
# moves the production alias that the model host serves.
WANDB_API_KEY=

# Amazon Bedrock API key, for `uv run redteam` (the slow check's red team). AWS_REGION defaults to us-east-1.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=

# A read token of the ecc-data repository on Telesphorepo, for `uv run restore`.
TELESPHOREPO_USER=
TELESPHOREPO_READ_TOKEN=
